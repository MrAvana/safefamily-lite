{
  "config": {
    "step": {
      "user": {
        "title": "SafeFamily Lite",
        "description": "Choose where this integration should get its data from: the Elari vendor cloud, or a private local backend that speaks the watch's own protocol.",
        "menu_options": {
          "cloud": "Elari vendor cloud (email / password)",
          "local": "Local backend (private server URL)"
        }
      },
      "cloud": {
        "title": "Elari vendor cloud",
        "description": "Sign in to the SafeFamily / Elari backend. Use the region your account was registered in (EU for most accounts; RU for Belarus/Russia).",
        "data": {
          "username": "Email",
          "password": "Password",
          "region": "Region"
        }
      },
      "local": {
        "title": "Local backend",
        "description": "URL of the private backend that speaks the watch's protocol, for example http://192.168.8.20:8080. The watch shows up here by itself once it has connected to that backend.",
        "data": {
          "local_url": "Backend URL",
          "local_name": "Watch name (optional)"
        }
      }
    },
    "error": {
      "auth": "Invalid credentials or wrong region. Check your email/password and try the other region.",
      "cannot_connect": "Unable to reach the SafeFamily API. Check your network and try again."
    },
    "abort": {
      "already_configured": "This backend is already configured."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "SafeFamily Lite options",
        "data": {
          "local_url": "Backend URL",
